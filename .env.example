ENHANCOR_API_KEY=
FAL_KEY=
BYTEPLUS_API_KEY=
KLINGAI_API_KEY=
QWENCLOUD_API_KEY=

# Post-generation scripts, split by output kind. POSTVIDGEN_<n> lines fill the three
# video drop-downs under Save folder, POSTIMGGEN_<n> lines fill the single image one.
# Each list is offered in numeric order; the drop-down slot number is the order they
# run in, and at most 3 run on any one video, 1 on any one image. Add POSTVIDGEN_4,
# POSTIMGGEN_2... to offer more choices.
# The value is the command, quoted. The saved file's path is appended as the last
# argument, or substituted for {} if the command names a spot for it. Each runs with
# its own folder as the working directory, so a relative venv activates.
POSTVIDGEN_1=
POSTVIDGEN_2=
POSTVIDGEN_3=

POSTIMGGEN_1=
POSTIMGGEN_2=